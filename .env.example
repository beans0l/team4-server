# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.
#   cp .env.example .env
#
# 🔐 .env 는 .gitignore 에 있어서 커밋되지 않습니다. 절대 키를 커밋하지 마세요.
#    저장소가 Public 이라 키가 올라가면 봇이 몇 분 안에 찾아냅니다. 구글이 키를
#    정지시키거나, 남이 우리 크레딧을 씁니다.
#
# 서버(가비아 VM)에서도 이 파일을 그대로 씁니다 — 서버에 .env 를 만들고
# `docker run --env-file .env` 로 넘기면 됩니다(README 참조).


# ─────────────────────────────────────────────────────────────
# 필수
# ─────────────────────────────────────────────────────────────

# https://aistudio.google.com/apikey 에서 발급.
# 비어 있으면 모든 변환 요청이 503 MISSING_API_KEY 로 실패합니다.
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────
# 저장소 — 결과 PNG 를 서버 디스크에 쓰고 /files 로 직접 서빙합니다
# ─────────────────────────────────────────────────────────────

# ⚠️ 기본값 /tmp 는 배포에서 쓰지 마세요. 리눅스가 /tmp 를 주기적으로 비우고,
#    도커 컨테이너 안의 /tmp 는 컨테이너를 다시 만들면 사라집니다. 둘 다 등록된
#    인형이 통째로 없어지는 결과가 됩니다.
#    도커로 띄운다면 이 경로에 볼륨(-v)도 같이 마운트하세요.
#    (로컬 개발에서는 기본값 /tmp 그대로 두면 됩니다. 아래는 서버용 예시)
# LOCAL_STORAGE_DIR=/data/doll-sprites


# ─────────────────────────────────────────────────────────────
# 성능 — 기본값으로 두어도 됩니다
# ─────────────────────────────────────────────────────────────

# 동시 처리 수. 요청 1건이 최대 약 1GB 를 씁니다(실측).
#   메모리 2GB 이하  -> 1
#   메모리 4GB       -> 2
# MAX_CONCURRENCY=2

# 파이프라인 전체 예산(초). 보통 12~14초, 재시도까지 가면 최대 약 35초.
# PIPELINE_TIMEOUT_SEC=90

# 업로드 상한(바이트, 기본 10MB)
# MAX_UPLOAD_BYTES=10485760


# ─────────────────────────────────────────────────────────────
# 모델·프롬프트 — 바꾸기 전에 README 를 읽으세요
# ─────────────────────────────────────────────────────────────

# ⚠️ Pro 로 바꾸지 마세요. 비싸고 느린 데다 결과가 나쁩니다(색이 파스텔로 밝아지고
#    없는 이목구비를 그려 넣습니다). 이 과제엔 덜 해석하는 모델이 맞습니다.
# GEMINI_MODEL=gemini-3.1-flash-image

# 배경 제거 모델. isnet 은 1.2초, birefnet 은 32~49초인데 결과는 99.3% 같습니다.
# u2net 계열은 빠르지만 인형을 든 손을 지우지 못합니다.
# REMBG_MODEL=isnet-general-use

# 프롬프트를 재배포 없이 갈아끼울 때. 비워두면 ai/doll_stylize_test.py 의
# ACTIVE_PROMPT 를 씁니다. 파일로 바꾸려면 server/prompts/stylize.txt 를 두세요.
# STYLIZE_PROMPT=


# ─────────────────────────────────────────────────────────────
# 스프라이트 세트 — 🔴 여기가 비용 스위치입니다
# ─────────────────────────────────────────────────────────────

# 립싱크·표정용 5장(mouth_closed/half/open + happy/sleepy)을 만듭니다.
#   1 → Gemini 5회 / 약 325원 / 28초 / 립싱크 O
#   0 → Gemini 1회 / 약  65원 / 12초 / 🔴 인형 입이 안 움직입니다
#
# 목 모드가 없어서 개발 중 호출도 전부 과금됩니다. 앱 배선을 반복 테스트할 때는
# 0 으로 두고, 5장은 계약 검증과 리허설에서만 돌리세요.
# ⚠️ 0 으로 두고 시연에 들어가지 않도록 /healthz 의 sprite_count 를 확인하세요.
# SPRITE_SET=1

# 뒷모습(6장째) 추가 여부. 기본은 꺼둡니다.
# R1 지표로 검증할 수 없고(실루엣이 달라야 정상이라 정렬 IoU 를 못 씁니다),
# 없어도 Z축 제자리 스핀으로 대체됩니다. 켜면 65원이 더 듭니다.
# SPRITE_BACK=0

# 변형 스프라이트 동시 생성 수. 순차로 하면 5장에 54초가 걸립니다(실측).
# 네트워크 대기라 CPU 를 쓰지 않으므로 MAX_CONCURRENCY 와는 별개입니다.
# SPRITE_PARALLEL=4

# 변형 프롬프트를 재배포 없이 갈아끼울 때. {"이름": "프롬프트"} 형식의 JSON 입니다.
# 비워두면 ai/sprite_test.py 의 SPRITE_PROMPTS(R1 을 검증한 그 문장들)를 씁니다.
# 파일로 바꾸려면 server/prompts/sprites.json 을 두세요.
# ⚠️ JSON 이 깨져 있으면 서버가 죽지 않고 기본값으로 돌아갑니다. 적용됐는지는
#    /healthz 의 sprite_prompt_source 로 확인하세요.
# SPRITE_PROMPTS=


# ─────────────────────────────────────────────────────────────
# 대화 (WS /doll/talk) — Gemini Live API
# ─────────────────────────────────────────────────────────────

# 음성↔음성 모델. 반드시 Live 를 지원하는 모델이어야 합니다.
# 일반 모델로 바꾸면 연결 자체가 안 됩니다(LIVE_UNAVAILABLE).
# LIVE_MODEL=gemini-3.1-flash-live-preview

# 인형 목소리. Google 이 제공하는 30개 중 하나만 고를 수 있고 음색 조절이나
# 커스텀 보이스 학습은 불가능합니다. 인형을 여러 개 등록하면 인형마다 다른
# 이름을 배정해 목소리를 구분할 수 있습니다.
# 후보: Leda(youthful) Puck Zephyr Achernar Laomedeia Sulafat Aoede Callirrhoe
# DOLL_VOICE=Leda

# 인형 성격. 실제 커스터마이징 레버는 목소리가 아니라 여깁니다.
# 비워두면 ai/dialog_test.py 의 DOLL_PERSONA 를 씁니다.
# 파일로 바꾸려면 server/prompts/persona.txt 를 두세요.
# ⚠️ 이걸 비워서 Live 에 넘기면 페르소나가 통째로 무시되고 존댓말 어시스턴트
#    톤이 나옵니다. (서버가 항상 채워 넣으므로 여기를 비워두는 건 안전합니다)
# DOLL_PERSONA=

# 동시 대화 수. 초과하면 즉시 TALK_BUSY 로 거절합니다(큐에 세우지 않습니다 —
# 대화 한 건이 밥 한 끼, 약 18분 동안 안 끝나기 때문입니다).
# 🔴 올리기 전에 Live 비용(R5)을 먼저 재세요. 무료 크레딧이 $10 뿐입니다.
# MAX_TALK_SESSIONS=2

# Live 연결이 끊겼을 때 재연결 시도 횟수. 앱의 WS 는 유지되고 맥락만 초기화됩니다
# (앱에는 session_reset 프레임이 갑니다).
# LIVE_RECONNECT_ATTEMPTS=3
